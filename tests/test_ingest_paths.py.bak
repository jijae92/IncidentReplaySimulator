from __future__ import annotations

from datetime import datetime, timezone

from src.ingest_replay_log.handler import _cloudtrail_key


def test_cloudtrail_key_format() -> None:
    event_time = datetime(2024, 1, 15, 12, 30, tzinfo=timezone.utc)
    key = _cloudtrail_key(event_time, account_id="111122223333", region="us-east-1")

    assert key.startswith("AWSLogs/111122223333/CloudTrail/us-east-1/2024/01/15/")
    assert key.endswith("111122223333_CloudTrail_us-east-1_20240115T123000Z.json")
