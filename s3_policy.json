{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnResultsPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::athena-results-bucket-897722691159",
      "Condition": { "StringLike": { "s3:prefix": ["athena/results/*"] } }
    },
    {
      "Sid": "ReadWriteResultsObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject","s3:PutObject",
        "s3:AbortMultipartUpload","s3:ListBucketMultipartUploads","s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::athena-results-bucket-897722691159/athena/results/*"
    }
  ]
}