from __future__ import annotations

"""Lambda entry point that seeds sample CloudTrail IAM CreateUser events."""

import json
import os
from datetime import datetime, timezone
from typing import Any, Dict

from aws_lambda_powertools import Logger, Tracer

from src.common.config import IRSConfig, load_config
from src.common.s3 import S3Client
from src.common.schemas import CloudTrailEvent

logger = Logger(service="ingest_replay_log")
tracer = Tracer(service="ingest_replay_log")


def _build_sample_event(account_id: str, region: str) -> CloudTrailEvent:
    """Construct a synthetic IAM CreateUser CloudTrail event."""
    timestamp = datetime.now(timezone.utc)
    return CloudTrailEvent(
        event_time=timestamp,
        event_name="CreateUser",
        user_name="malicious-user",
        request_parameters={"userName": "malicious-user"},
        additional_event_data={
            "MFAUsed": "No",
            "SourceIPAddress": "203.0.113.42",
            "AWSRegion": region,
            "RecipientAccountId": account_id,
        },
    )


def _cloudtrail_key(event_time: datetime, account_id: str, region: str) -> str:
    """Render the CloudTrail-compatible S3 object key."""
    return (
        f"AWSLogs/{account_id}/CloudTrail/{region}/"
        f"{event_time:%Y/%m/%d}/{account_id}_CloudTrail_{region}_{event_time:%Y%m%dT%H%M%SZ}.json"
    )


@tracer.capture_lambda_handler
@logger.inject_lambda_context(clear_state=True)
def lambda_handler(event: Dict[str, Any], context: Any) -> Dict[str, Any]:
    """
    Lambda handler for seeding replay events.

    TODO: Replace the synthetic payload with sampled production events when approved.
    """
    config: IRSConfig = load_config()
    account_id = os.getenv("AWS_ACCOUNT_ID", "000000000000")
    region = os.getenv("AWS_REGION", "us-east-1")

    sample_event = _build_sample_event(account_id=account_id, region=region)
    key = _cloudtrail_key(sample_event.event_time, account_id=account_id, region=region)

    s3_client = S3Client(config=config)
    s3_client.put_json(config.replay_bucket, key, json.loads(json.dumps(sample_event, default=str)))

    logger.info(
        "Seeded IAM CreateUser event into S3",
        extra={"bucket": config.replay_bucket, "key": key},
    )

    return {
        "statusCode": 200,
        "body": {
            "message": "Replay log ingested",
            "bucket": config.replay_bucket,
            "key": key,
        },
    }
