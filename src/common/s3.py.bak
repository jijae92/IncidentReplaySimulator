from __future__ import annotations

"""
S3 helpers with explicit timeouts and exponential backoff.

Security: load secrets via .env/secret manager; mask tokens/keys in logs; 10s timeout+backoff; least privilege.
"""

import json
import logging
from typing import Any, Dict, Optional

import boto3
from botocore.client import BaseClient
from botocore.config import Config as BotoConfig
from botocore.exceptions import ClientError
from tenacity import retry, retry_if_exception_type, stop_after_attempt, wait_exponential

from .config import IRSConfig

LOGGER = logging.getLogger(__name__)


class S3Client:
    """Convenience wrapper around boto3 S3 client."""

    def __init__(
        self,
        config: IRSConfig,
        boto_session: Optional[boto3.session.Session] = None,
    ) -> None:
        session = boto_session or boto3.session.Session()
        boto_config = BotoConfig(
            connect_timeout=config.query_timeout_seconds,
            read_timeout=config.query_timeout_seconds,
            retries={"max_attempts": config.max_retries},
        )
        self._s3: BaseClient = session.client("s3", config=boto_config)

    @retry(
        reraise=True,
        stop=stop_after_attempt(3),
        wait=wait_exponential(multiplier=1, min=1, max=8),
        retry=retry_if_exception_type(ClientError),
    )
    def put_json(self, bucket: str, key: str, payload: Dict[str, Any]) -> None:
        """Write a JSON document to S3."""
        LOGGER.info("Uploading JSON to S3 bucket=%s key=%s", bucket, key)
        body = json.dumps(payload, separators=(",", ":"), default=str).encode("utf-8")
        self._s3.put_object(Bucket=bucket, Key=key, Body=body, ContentType="application/json")

    @retry(
        reraise=True,
        stop=stop_after_attempt(3),
        wait=wait_exponential(multiplier=1, min=1, max=8),
        retry=retry_if_exception_type(ClientError),
    )
    def put_bytes(self, bucket: str, key: str, data: bytes, content_type: str) -> None:
        """Write raw bytes to S3."""
        LOGGER.info("Uploading object to S3 bucket=%s key=%s", bucket, key)
        self._s3.put_object(Bucket=bucket, Key=key, Body=data, ContentType=content_type)

    def object_exists(self, bucket: str, key: str) -> bool:
        """Check for object existence without raising on 404."""
        try:
            self._s3.head_object(Bucket=bucket, Key=key)
            return True
        except ClientError as exc:  # pragma: no cover - boto exceptions mocked in tests
            if exc.response["Error"]["Code"] == "404":
                return False
            raise
