from __future__ import annotations

"""
Configuration helpers for Incident Replay Simulator Lambdas.

Security: load secrets via .env/secret manager; mask tokens/keys in logs; 10s timeout+backoff; least privilege.
"""

import os
from dataclasses import dataclass
from typing import Optional

from dotenv import load_dotenv

# Load a local .env when running outside Lambda. No-op in the service.
load_dotenv()


@dataclass(frozen=True)
class IRSConfig:
    """Structured configuration shared across functions."""

    replay_bucket: str
    results_bucket: str
    glue_database: str
    athena_workgroup: str
    sns_topic_arn: str
    query_timeout_seconds: int = 10
    max_retries: int = 3

    @property
    def athena_output_prefix(self) -> str:
        """Return S3 prefix where Athena writes results."""
        return "athena/results/"


def _require_env(name: str, default: Optional[str] = None) -> str:
    """Fetch environment variable or raise a descriptive error."""
    value = os.getenv(name, default)
    if value is None or value.strip() == "":
        raise EnvironmentError(
            f"Missing required configuration: {name}. "
            "Set it via environment variable or .env."
        )
    return value


def load_config() -> IRSConfig:
    """Assemble runtime configuration from environment variables."""
    return IRSConfig(
        replay_bucket=_require_env("IRS_REPLAY_BUCKET"),
        results_bucket=_require_env("IRS_RESULTS_BUCKET"),
        glue_database=_require_env("IRS_GLUE_DATABASE", "irs_db"),
        athena_workgroup=_require_env("IRS_ATHENA_WORKGROUP", "irs_wg"),
        sns_topic_arn=_require_env("IRS_SNS_TOPIC_ARN"),
        query_timeout_seconds=int(_require_env("IRS_QUERY_TIMEOUT_SECONDS", "10")),
        max_retries=int(_require_env("IRS_MAX_RETRIES", "3")),
    )
