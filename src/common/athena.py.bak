from __future__ import annotations

"""
Athena orchestration helpers with retry and timeout safeguards.

Security: load secrets via .env/secret manager; mask tokens/keys in logs; 10s timeout+backoff; least privilege.
"""

import logging
import time
from dataclasses import dataclass
from typing import Optional

import boto3
from botocore.client import BaseClient
from botocore.config import Config as BotoConfig
from botocore.exceptions import ClientError
from tenacity import (
    RetryError,
    retry,
    retry_if_exception_type,
    stop_after_attempt,
    wait_exponential,
)

from .config import IRSConfig

LOGGER = logging.getLogger(__name__)


@dataclass(frozen=True)
class AthenaQueryResult:
    """Container for Athena query identifiers."""

    query_execution_id: str
    output_location: str


class AthenaClient:
    """Thin wrapper around boto3 Athena client with bounded retries."""

    def __init__(
        self,
        config: IRSConfig,
        boto_session: Optional[boto3.session.Session] = None,
    ) -> None:
        self._config = config
        session = boto_session or boto3.session.Session()
        timeout = max(config.query_timeout_seconds, 10)
        retry_attempts = max(config.max_retries, 3)
        client_config = BotoConfig(
            connect_timeout=timeout,
            read_timeout=timeout,
            retries={"max_attempts": retry_attempts},
        )
        self._athena: BaseClient = session.client("athena", config=client_config)

    def start_query(self, query: str, description: str = "irs-query") -> AthenaQueryResult:
        """Submit a query to Athena and return execution metadata."""
        LOGGER.info(
            "Submitting Athena query: description=%s, workgroup=%s",
            description,
            self._config.athena_workgroup,
        )
        response = self._athena.start_query_execution(
            QueryString=query,
            WorkGroup=self._config.athena_workgroup,
            QueryExecutionContext={"Database": self._config.glue_database},
            ResultConfiguration={
                "OutputLocation": f"s3://{self._config.results_bucket}/{self._config.athena_output_prefix}"
            },
        )
        execution_id = response["QueryExecutionId"]
        output = f"s3://{self._config.results_bucket}/{self._config.athena_output_prefix}{execution_id}.csv"
        return AthenaQueryResult(query_execution_id=execution_id, output_location=output)

    def wait_for_completion(self, execution_id: str, poll_interval: int = 2) -> str:
        """
        Poll Athena until the query finishes.

        Returns the final state (SUCCEEDED/FAILED/CANCELLED).
        """
        LOGGER.debug("Polling Athena execution_id=%s", execution_id)
        deadline = time.time() + self._config.query_timeout_seconds
        while time.time() < deadline:
            result = self._athena.get_query_execution(QueryExecutionId=execution_id)
            state = result["QueryExecution"]["Status"]["State"]
            if state in {"SUCCEEDED", "FAILED", "CANCELLED"}:
                LOGGER.info("Athena query finished: execution_id=%s, state=%s", execution_id, state)
                if state != "SUCCEEDED":
                    reason = result["QueryExecution"]["Status"].get("StateChangeReason", "Unknown")
                    LOGGER.warning("Athena query did not succeed: %s", reason)
                return state
            time.sleep(poll_interval)

        LOGGER.error(
            "Athena query timed out after %s seconds: execution_id=%s",
            self._config.query_timeout_seconds,
            execution_id,
        )
        raise TimeoutError(
            f"Athena query {execution_id} did not complete within {self._config.query_timeout_seconds}s."
        )

    def fetch_results(self, execution_id: str) -> dict:
        """Fetch query results; returns the raw boto3 payload."""
        LOGGER.debug("Fetching Athena results execution_id=%s", execution_id)
        try:
            return self._athena.get_query_results(QueryExecutionId=execution_id)
        except ClientError as exc:  # pragma: no cover - boto exceptions mocked in tests
            LOGGER.error("Unable to fetch Athena results: %s", exc, extra={"execution_id": execution_id})
            raise

    @retry(
        reraise=True,
        stop=stop_after_attempt(3),
        wait=wait_exponential(multiplier=1, min=1, max=8),
        retry=retry_if_exception_type(ClientError),
    )
    def guarded_start_and_wait(self, query: str, description: str = "irs-query") -> AthenaQueryResult:
        """Submit a query and wait for completion with exponential backoff on client errors."""
        result = self.start_query(query=query, description=description)
        state = self.wait_for_completion(result.query_execution_id)
        if state != "SUCCEEDED":
            raise RetryError(f"Athena query {result.query_execution_id} finished with state {state}")
        return result
