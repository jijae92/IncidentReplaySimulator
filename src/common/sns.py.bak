from __future__ import annotations

"""
SNS helper to publish notifications with masked payloads.

Security: load secrets via .env/secret manager; mask tokens/keys in logs; 10s timeout+backoff; least privilege.
"""

import json
import logging
from typing import Any, Dict, Optional

import boto3
from botocore.client import BaseClient
from botocore.config import Config as BotoConfig
from botocore.exceptions import ClientError
from tenacity import retry, retry_if_exception_type, stop_after_attempt, wait_exponential

from .config import IRSConfig

LOGGER = logging.getLogger(__name__)


class SNSClient:
    """Publish JSON notifications to SNS with bounded retries."""

    def __init__(
        self,
        config: IRSConfig,
        boto_session: Optional[boto3.session.Session] = None,
    ) -> None:
        session = boto_session or boto3.session.Session()
        boto_config = BotoConfig(
            connect_timeout=config.query_timeout_seconds,
            read_timeout=config.query_timeout_seconds,
            retries={"max_attempts": config.max_retries},
        )
        self._sns: BaseClient = session.client("sns", config=boto_config)
        self._topic_arn = config.sns_topic_arn

    @retry(
        reraise=True,
        stop=stop_after_attempt(3),
        wait=wait_exponential(multiplier=1, min=1, max=8),
        retry=retry_if_exception_type(ClientError),
    )
    def publish(self, subject: str, message: Dict[str, Any]) -> Dict[str, Any]:
        """
        Publish a JSON message to the configured topic.

        Returns the SNS publish response.
        """
        masked = {**message, "token": "***" if "token" in message else message.get("token")}
        LOGGER.info("Publishing SNS notification subject=%s size=%s", subject, len(json.dumps(message)))
        response = self._sns.publish(
            TopicArn=self._topic_arn,
            Subject=subject[:100],  # SNS subject character limit
            Message=json.dumps(message, default=str),
            MessageAttributes={
                "incident": {
                    "DataType": "String",
                    "StringValue": "iam-create-user",
                }
            },
        )
        LOGGER.debug("SNS publish response id=%s", response.get("MessageId"))
        return response
