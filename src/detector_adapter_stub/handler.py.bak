from __future__ import annotations

"""Detector adapter stub that simulates detection decisions."""

import json
from typing import Any, Dict, List

from aws_lambda_powertools import Logger, Tracer

from src.common.config import IRSConfig, load_config
from src.common.s3 import S3Client
from src.common.schemas import DetectionRecord

logger = Logger(service="detector_adapter_stub")
tracer = Tracer(service="detector_adapter_stub")


def _simulate_detection(records: List[Dict[str, Any]]) -> DetectionRecord:
    """
    Simulate a detection engine by flagging CreateUser events without MFA.

    TODO: Replace with integration to the real detection microservice.
    """
    if not records:
        return DetectionRecord(user_name="unknown", detected=False, confidence=0.0, findings=["no-records"])

    record = records[0]
    findings = []
    detected = False
    if record.get("eventName") == "CreateUser" and record.get("additionalEventData", {}).get("MFAUsed") == "No":
        detected = True
        findings.append("create-user-no-mfa")
    return DetectionRecord(
        user_name=record.get("userName", "unknown"),
        detected=detected,
        confidence=0.8 if detected else 0.1,
        findings=findings or ["no-indicators"],
    )


@tracer.capture_lambda_handler
@logger.inject_lambda_context(clear_state=True)
def lambda_handler(event: Dict[str, Any], context: Any) -> Dict[str, Any]:
    """
    Stub handler for detection pipeline.

    Expected event:
    {
        "metadata_key": "athena/results/<execution_id>/metadata.json"
    }
    """
    config: IRSConfig = load_config()
    s3_client = S3Client(config=config)

    metadata_key = event.get("metadata_key")
    if not metadata_key:
        raise ValueError("Event missing metadata_key")

    logger.info("Loading Athena metadata for detection", extra={"metadata_key": metadata_key})
    metadata_raw = s3_client.get_object_text(config.results_bucket, metadata_key)
    metadata = json.loads(metadata_raw)

    # TODO: parse actual Athena CSV result once integrated.
    detection = _simulate_detection(
        [
            {
                "eventName": "CreateUser",
                "userName": "malicious-user",
                "additionalEventData": {"MFAUsed": "No"},
            }
        ]
    )

    logger.info("Detector stub decision", extra={"detected": detection.detected})

    return {
        "statusCode": 200,
        "body": {
            "metadata": metadata,
            "detection": detection.__dict__,
        },
    }
