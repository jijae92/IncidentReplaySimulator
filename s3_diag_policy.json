{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "ListBucketOptional",
      "Effect": "Allow",
      "Action": ["s3:ListBucket","s3:GetBucketLocation","s3:GetBucketPolicy","s3:GetBucketOwnershipControls","s3:GetEncryptionConfiguration"],
      "Resource": "arn:aws:s3:::test-replay-bucket"
    },
    { "Sid": "RWObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject","s3:GetObject","s3:AbortMultipartUpload","s3:ListBucketMultipartUploads","s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::test-replay-bucket/*"
    }
  ]
}
