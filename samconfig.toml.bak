version = 0.1

[default.deploy.parameters]
stack_name = "sam-app"
resolve_s3 = true
s3_prefix = "sam-app"
region = "ap-northeast-2"
confirm_changeset = true
capabilities = "CAPABILITY_IAM"
disable_rollback = true
parameter_overrides = "ReplayBucket=\"cloudtrail-replay-bucket\" ResultsBucket=\"athena-results-bucket\" AthenaWorkGroup=\"irs_wg\" GlueDbName=\"irs_db\" NotificationEmail=\"\""
image_repositories = []

[default.global.parameters]
region = "ap-northeast-2"
