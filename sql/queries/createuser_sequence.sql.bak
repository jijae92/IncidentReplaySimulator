-- Athena query for IAM CreateUser replay analysis.
-- The orchestrator may inject additional predicates via event payload in the future.

WITH create_events AS (
    SELECT
        from_iso8601_timestamp(eventtime) AS event_ts,
        requestparameters.username AS user_name,
        additionaleventdata,
        sourceipaddress,
        awsregion
    FROM irs_db.cloudtrail_create_user
    WHERE eventname = 'CreateUser'
      AND eventtime IS NOT NULL
      AND from_iso8601_timestamp(eventtime) >= date_add('hour', -24, current_timestamp)
)
SELECT
    date_format(event_ts, '%Y-%m-%dT%H:%i:%sZ') AS event_time,
    user_name,
    awsregion,
    sourceipaddress,
    additionaleventdata['MFAUsed'] AS mfa_used
FROM create_events
ORDER BY event_ts DESC;
